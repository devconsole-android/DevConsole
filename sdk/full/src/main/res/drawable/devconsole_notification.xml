<?xml version="1.0" encoding="utf-8"?>
<!--
    Status-bar silhouette of the DevConsole mark: the terminal frame with its prompt glyphs, drawn
    as strokes on transparent. Notification small icons are flattened to a single tinted alpha mask
    by the platform, so the colour artwork (drawable/devconsole_logo.webp, used as the large icon
    alongside this one) cannot be used here; it would render as a solid filled square.

    Sized on the 24dp status-bar grid with the standard 2dp safe margin on every edge.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M5,4.5 H19 A2.5,2.5 0 0 1 21.5,7 V17 A2.5,2.5 0 0 1 19,19.5 H5 A2.5,2.5 0 0 1 2.5,17 V7 A2.5,2.5 0 0 1 5,4.5 Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.7"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M6.8,9 L10.2,12 L6.8,15"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M12.6,15 H17.2"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.9"
        android:strokeLineCap="round" />
</vector>
